FRONTEND_PORT=8080

# Single backend host for all services (path-based routing via nginx)
# Auth: /api/v1/auth, Companies: /api/v1/companies, Applications: /api/v1/applications, etc.
BACKEND_URL=https://api.traineematch.space

VITE_API_URL=
VITE_USE_MSW=false
SYNC_SWAGGER=false

# Microservice routing — прямые URL до api.traineematch.space/{service}
# При сборке через docker compose подставляются автоматом (см. defaults в docker-compose.yml)
# Если нужно переопределить отдельный сервис — раскомментировать и указать свой URL
VITE_BASE_URL=https://api.traineematch.space
VITE_AUTH_URL=https://api.traineematch.space/api/auth
VITE_APPLICATION_URL=https://api.traineematch.space/api/application
VITE_CANDIDATE_URL=https://api.traineematch.space/api/candidate
VITE_COMPANY_URL=https://api.traineematch.space/api/company
